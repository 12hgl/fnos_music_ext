appname               = fnmusic-ext
version               = @VERSION@
display_name          = fnMusic 音源扩展
desc                  = fnmusic-ext 是专为飞牛私有云（fnOS）自带音乐应用打造的无侵入增强扩展：零侵入接管官方音乐入口，提供 musicdl 聚合、网易云（盒子/免扫码）、洛雪自定义源在线搜索播放，支持分类歌单、38 个热门榜单、自定义歌单（导入 m3u/m3u8/pls/cue 或大模型点歌）与内置大模型推荐，内置管理页（音源切换/扫码登录/平台选择/边听边存/检测更新），可随时一条命令还原官方直连。
platform              = @PLATFORM@
source                = thirdparty
maintainer            = 12hgl
maintainer_url        = https://github.com/12hgl/fnos_music_ext
os_min_version        = 1.2.0
install_dep_apps      = trim.music
desktop_uidir         = ui
desktop_applaunchname = fnmusic-ext.main
checkport             = false
micro_app             = true
