#!/bin/bash
# Fast prechecks before the package files are laid down; install.sh re-checks
# everything with detailed messages. 安装固定走原生（免 Docker）形态（见
# install_callback 的 --deploy native），故 Docker 不再是硬前置：唯一硬前置是
# 官方「飞牛音乐」已在运行。

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

[ -S /var/run/trim_music.socket ] || [ -S /var/run/trim_music_upstream.socket ] || fnmusic_fail "未检测到官方\"飞牛音乐\"：请先在应用中心安装并启动飞牛音乐"

exit 0
